# Copy to .env and edit. NEVER commit .env. Secrets are never logged or shown in the dashboard.

# Only internal paper trading exists: RESEARCH | BACKTEST | PAPER   (LIVE and BROKER_DEMO are rejected)
TRADEDESK_MODE=PAPER
TRADEDESK_DB_PATH=data/tradedesk.db
TRADEDESK_RISK_LIMITS_FILE=config/risk_limits.toml

# Virtual account (house rules of the internal PaperBroker)
TRADEDESK_PAPER_INITIAL_BALANCE=100
TRADEDESK_PAPER_SLIPPAGE_POINTS=2
TRADEDESK_PAPER_STOP_OUT_LEVEL_PCT=50

# Market data: provider chain tried in order. MOCK is never used unless listed here explicitly.
TRADEDESK_DATA_SOURCE=OANDA,DUKASCOPY
TRADEDESK_SYMBOLS=XAUUSD,XAGUSD,EURUSD,GBPUSD,USDJPY,US500
TRADEDESK_QUOTE_POLL_SECONDS=15
# OANDA v20 practice API — READ-ONLY use (pricing + candles). Free practice account; token from OANDA's site.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# Autonomy while the server runs
TRADEDESK_AUTONOMOUS=true
TRADEDESK_CYCLE_MINUTES=15

# Access from a phone: when exposing beyond localhost, an access token is REQUIRED (the app refuses otherwise).
TRADEDESK_API_HOST=127.0.0.1
TRADEDESK_API_PORT=8000
TRADEDESK_ACCESS_TOKEN=
# Owner actions (specs, strategy activation, close-all, reset) additionally need this header token if set
TRADEDESK_OWNER_TOKEN=

# Optional LLM review (can only make decisions more conservative): none | anthropic
TRADEDESK_LLM_PROVIDER=none
TRADEDESK_LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
