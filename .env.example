# OKX DEMO TRADING credentials (OKX → Trade → Demo Trading → Personal Center → Demo Trading API).
# Copy to .env (git-ignored). Never commit real values. Do NOT enable withdrawal permission.
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=

# Optional
DESK_INST_IDS=BTC-USDT-SWAP,ETH-USDT-SWAP
DESK_LEVERAGE=3
DESK_PAPER_EQUITY=10000      # used only when no credentials are configured
DESK_REQUIRE_NEWS=0          # 1 = no news source => NOT ENOUGH DATA
DESK_LLM=0                   # 1 = add the optional Claude reviewer (needs `pip install anthropic` + API key)
