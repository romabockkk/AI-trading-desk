# Copy to .env and edit. NEVER commit .env. Secrets are never logged.

# Operating mode: RESEARCH | BACKTEST | PAPER | BROKER_DEMO   (LIVE does not exist)
TRADEDESK_MODE=PAPER

# SQLite database path
TRADEDESK_DB_PATH=data/tradedesk.db

# Owner-controlled risk limits file (agents can only read it)
TRADEDESK_RISK_LIMITS_FILE=config/risk_limits.toml

# BROKER_DEMO is disabled by default. Enabling requires BOTH flags below AND
# passing integration tests AND a verified DEMO account at runtime.
TRADEDESK_BROKER_DEMO_ENABLED=false
# Set to the exact phrase "I_AUTHORIZE_DEMO_ORDERS_ONLY" only after explicit owner approval.
TRADEDESK_OWNER_DEMO_AUTHORIZATION=

# Exact MT5 demo server names allowed (comma separated). Confirm in your MT5 login window.
TRADEDESK_ALLOWED_DEMO_SERVERS=Bybit-Demo

# MT5 credentials (Windows host only). Leave empty on Linux.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Market data source: MOCK is the only source available until a broker/data feed is connected.
TRADEDESK_DATA_SOURCE=MOCK
TRADEDESK_SYMBOL=XAUUSD
# Automatic analysis cycles every N minutes (0 = only when you press Start Analysis)
TRADEDESK_SCHEDULER_MINUTES=0
TRADEDESK_PAPER_INITIAL_BALANCE=10000
# If set, owner actions (activate strategy, approve experiment, reset kill switch) need header X-Owner-Token
TRADEDESK_OWNER_TOKEN=

# LLM provider: none | anthropic   ("none" = deterministic agents only, no API cost)
# The LLM only reviews reports and can only make decisions MORE conservative.
TRADEDESK_LLM_PROVIDER=none
TRADEDESK_LLM_MODEL=claude-opus-5-5
LLM_API_KEY=

# API server
TRADEDESK_API_HOST=127.0.0.1
TRADEDESK_API_PORT=8000
